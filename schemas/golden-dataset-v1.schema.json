{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeai.dev/schemas/golden-dataset-v1.schema.json",
  "title": "ForgeAI Golden Dataset v1",
  "type": "object",
  "required": ["schema_version", "id", "version", "knowledge_base_id", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "knowledge_base_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "query"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "relevant_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "relevant_chunk_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_answer": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "category": {"type": "string"},
          "difficulty": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
