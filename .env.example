# docker compose 用。コピーして .env として使う(.env は git 管理外)。

# `forgeai init` が出力する base64 のマスターキー(シークレット暗号化用)
FORGEAI_MASTER_KEY=

# OpenAI 互換 API のキー。空のままにして `echo "$KEY" | forgeai secret set openai` でも可(値は引数ではなく stdin から渡す)
FORGEAI_OPENAI_API_KEY=

# Cloudflare Zero Trust → Networks → Tunnels で作成したトンネルのトークン
TUNNEL_TOKEN=

# 任意: イメージに埋め込むバージョン文字列
FORGEAI_VERSION=dev
